    {"type": "file_equals", "path": "settings.ini", "value": "[ui]\ncolor = blue\nfont = serif\n"},
    {"type": "file_unchanged", "path": "notes.txt"},
    {"type": "answer_contains", "value": "done"}
  ],
  "max_steps": 6,
  "solution": [
    {"tool": "read_file", "args": {"path": "settings.ini"}},
    {"tool": "write_file", "args": {"path": "settings.ini", "content": "[ui]\ncolor = blue\nfont = serif\n"}},
    {"final": "done"}
  ]
}
