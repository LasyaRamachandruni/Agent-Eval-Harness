{
  "id": "example-rename-key",
  "category": "files",
  "prompt": "In settings.ini, rename the key 'colour' to 'color' and keep everything else the same. Then reply 'done'.",
  "files": {
    "settings.ini": "[ui]\ncolour = blue\nfont = serif\n",
    "notes.txt": "Remember: settings.ini is read by the UI at startup.\n"
  },
