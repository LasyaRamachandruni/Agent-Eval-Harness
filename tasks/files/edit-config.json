      "type": "file_equals",
      "path": "settings.ini",
      "value": "[server]\nhost = 0.0.0.0\nport = 9090\n\n[logging]\nlevel = info\n"
    }
  ],
  "max_steps": 5,
  "solution": [
    {
      "tool": "read_file",
      "args": {
        "path": "settings.ini"
      }
    },
    {
      "tool": "write_file",
      "args": {
        "path": "settings.ini",
        "content": "[server]\nhost = 0.0.0.0\nport = 9090\n\n[logging]\nlevel = info\n"
      }
    },
    {
      "final": "done"
    }
  ]
}
